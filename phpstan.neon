includes:
	- phpstan-baseline.neon

parameters:
		parallel:
				maximumNumberOfProcesses: 5

		level: 7

		bootstrapFiles:
				- vendor/autoload.php

		paths:
				- Classes
				- Configuration
				- Resources
				- Tests

		ignoreErrors:
				- '#return type has no value type specified in iterable type array#'
				- '#with no value type specified in iterable type array#'

		typo3:
				requestGetAttributeMapping:
						tca_api.api_prefix: string
						tca_api.uid: int|null
						tca_api.operation: string
						tca_api.fields: mixed
						tca_api.page: mixed
						tca_api.items_per_page: mixed
						tca_api.filters: mixed
						tca_api.order: mixed
						tca_api.partial: mixed
						tca_api.existing_record: array|null
						tca_api.language: TYPO3\CMS\Core\Site\Entity\SiteLanguage|null
						tca_api.language_id: int|null
						tca_api.request_prefix: string|null
