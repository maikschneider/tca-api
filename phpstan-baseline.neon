parameters:
	ignoreErrors:
		-
			message: '#^Offset ''filename'' on array\{dirname\?\: string, basename\: string, extension\?\: string, filename\: string\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: Classes/Configuration/UploadDefinition.php

		-
			message: '#^Instanceof between TYPO3\\CMS\\Core\\Http\\UploadedFile and TYPO3\\CMS\\Core\\Http\\UploadedFile will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 2
			path: Classes/OperationHandler/CreateHandler.php

		-
			message: '#^Instanceof between TYPO3\\CMS\\Core\\Http\\UploadedFile and TYPO3\\CMS\\Core\\Http\\UploadedFile will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 2
			path: Classes/OperationHandler/UpdateHandler.php
