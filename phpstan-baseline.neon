parameters:
	ignoreErrors:
		-
			message: '#^Call to function array_is_list\(\) with \*NEVER\* will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: Classes/DataAccess/RelationInputResolver.php

		-
			message: '#^Call to function is_array\(\) with float\|int\|numeric\-string will always evaluate to false\.$#'
			identifier: function.impossibleType
			count: 1
			path: Classes/DataAccess/RelationInputResolver.php

		-
			message: '#^Result of && is always false\.$#'
			identifier: booleanAnd.alwaysFalse
			count: 2
			path: Classes/DataAccess/RelationInputResolver.php

		-
			message: '#^Call to an undefined method TYPO3\\CMS\\Core\\Schema\\Field\\RelationalFieldTypeInterface\:\:getConfiguration\(\)\.$#'
			identifier: method.notFound
			count: 3
			path: Classes/Serializer/ResourceSerializer.php
